---
import ItemHero from "./item-hero.astro";

import styles from "./hero.module.scss";
import PrevNext from "../../PrevNext.astro";

const url = 'https://www.google.com/calendar/event?action=TEMPLATE&text=Boda%20Christian%20y%20Melandia&dates=20260703T170000Z/20260703T200000Z&details=Descripci%C3%B3n&location=https://maps.app.goo.gl/CxAHaE9Hr17aiPit9';

---
<div id="hero" class={["relative full-width", "container", styles.hero].join(' ')}>
  <div class={styles.box}>
    <p  data-aos="zoom-in" class={styles.box__description}>Celebrando el día que el Señor preparó para nosotros</p>
    <div style="width: 100%; padding: 12px" data-aos="zoom-in-down">
      <h1 style="text-align: left;" class={styles.box__title}>Christian <!-- <span style="font-size: 0.7em;">J.</span> --></h1>
      <h1  style="text-align: center;" class={styles.box__title}>& </h1>
      <h1 style="text-align: right;" class={styles.box__title}>Melandia</h1>
    </div>

    <div data-aos="zoom-in" class="hiddenVideo">
      <p class={styles.box__description}>Julio 03, 2026 - Bolivia, Cbba.</p>

      <!-- <a class={styles.box__btn}  href={url} target="_blank" rel="noopener noreferrer">Guardar a calendario</a> -->
    </div>

    <p data-aos="zoom-in" class={styles.box__description}>Con la bendición de Dios y el gozo de nuestros padres, te invitamos a celebrar junto a nosotros este día tan especial</p>

  </div>
  <div class={styles["item__container"]}>
    <div class={[styles.item, styles["item--left"]].join(' ')}>
      <ItemHero urlBg="./images/photo1.png" small />
    </div>

    <div class={[styles.item, styles["item--right"]].join(' ')}>
      <ItemHero urlBg="./images/photo3.png" small />
    </div>
  </div>
  
  <PrevNext prev="#header" next="#agree"  />
  
</div>

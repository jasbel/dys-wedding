---
import ItemHero from "./item-hero.astro";

import styles from "./hero.module.scss";
import PrevNext from "../../PrevNext.astro";

const url = 'https://www.google.com/calendar/event?action=TEMPLATE&text=Boda%20Asbel%20y%20Loida&dates=20240127T190000Z/20240128T000000Z&details=Descripci%C3%B3n&location=https://maps.app.goo.gl/YDCur2fUJ2B9qLn9A';

---
<div id="hero" class={["relative full-width", "container", styles.hero].join(' ')}>
  <div class={styles.box}>
    <p  data-aos="zoom-in" class={styles.box__description}>Celebrando nuestro dia mas especial</p>
    <div style="width: 100%; padding: 12px" data-aos="zoom-in-down">
      <h1 style="text-align: left;" class={styles.box__title}>Asbel <!-- <span style="font-size: 0.7em;">J.</span> --></h1>
      <h1  style="text-align: center;" class={styles.box__title}>& </h1>
      <h1 style="text-align: right;" class={styles.box__title}>Loida</h1>
    </div>

    <div data-aos="zoom-in" class="hiddenVideo">
      <p class={styles.box__description}>Enero 27, 2024 - Bolivia, Cbba.</p>

      <a class={styles.box__btn}  href={url} target="_blank" rel="noopener noreferrer">Guardar a calendario</a>
    </div>

    <p data-aos="zoom-in" class={styles.box__description}>Queremos compartir contigo la felicidad de nuestra union.</p>
    
  </div>
  <div  data-aos="zoom-in-up" class={styles["item__container"]}>
    <div class={[styles.item, styles["item--left"]].join(' ')}>
      <ItemHero urlBg="./images/photo1.png" small />
    </div>

    <div class={[styles.item, styles["item--right"]].join(' ')}>
      <ItemHero urlBg="./images/photo3.png" small />
    </div>
  </div>
  
  <PrevNext prev="#header" next="#agree"  />
  
</div>

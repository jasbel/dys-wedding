---
import PrevNext from "../../PrevNext.astro";
import WeddingLogo from "../../icons/wedding-logo.astro";

import styles from "./header.module.scss";

---
<header id="header" class={['relative' ,styles.header].join(' ')}>
  <div class={styles.wrapper}>
    <ul class={styles.content}>
      <li class={styles.item}>
      <a href="#" >
          {/* Bienvenido */}
        </a>
      </li>
      <li class={styles.item}>
        <a href="#history" >
          {/* history */}
        </a>
      </li>
      <li class={styles.item}>
        <a href="#invitation" >
          {/* invitation */}
        </a>
      </li>
      <li class={styles.item}>
        <a href="#schedule" >
          {/* schedule */}
        </a>
      </li>
      <li class={[styles.item, styles.logo].join(' ')}>
        <div data-aos="zoom-in" class={styles.logo}>
          <a href="/" title="logo">
            <img src={"./images/logo.png"} class={styles.logopng} />
            <!-- <WeddingLogo height={136} width={125} /> -->
          </a>
        </div>
      </li>
      <li class={styles.item}>
        <a href="#transportation" >
          {/* transportation */}
        </a>
      </li>
      <li class={styles.item}>
        <a href="#mail" >
          {/* mail */}
        </a>
      </li>
      <li class={styles.item}>
        <a href="#photos" >
          {/* photos */}
        </a>
      </li>
      <li class={styles.item}>
        <a href="#timer" >
          {/* timer */}
        </a>
      </li>
    </ul>
  </div>

  <PrevNext prev="#" next="#hero"/>
</header>
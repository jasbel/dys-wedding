---
import Section from "../layout/section/section.astro";
import PrevNext from "../PrevNext.astro";
import weddingData from "../../data/wedding-data.ts";

const { agree } = weddingData;
---

<Section className={["section section-center", "relative"].join(" ")} id="agree">
    <div data-aos="flip-up">
        <div class="box">
            <p class="description">
                {agree.description}
            </p>
        </div>

    </div>

    <PrevNext prev="#hero" next="#invitation" />
</Section>
<style>
    .box {
        background-color: white;
        padding: 12px;
    }

    .description {
        font-size: 1.2rem;
        text-align: center;
        line-height: 1.6;
    }
</style>

---
import Section from "../../../../src/components/layout/section/section.astro";
import PrevNext from "../../PrevNext.astro";
import ItemTransportation from "./item-transportation.astro";

import styles from "./transportation.module.scss";
---
<Section id="transportation" className={['relative',styles.section].join(' ')}>
  <div class={styles.header}>
    <h2 class={styles.title} data-aos="zoom-in-down">
      {/* <Slot name="title" /> */}
      Transporte
    </h2>
    <p data-aos="fade-right" class={styles.description}>
    <!-- Dejamos a tu disposición numerosas líneas de transporte que te acercan directamente al lugar del evento, proporcionándote así información detallada para tu conveniencia. -->
    Algunas opciones de transporte directo al evento para tu conveniencia.
    </p>
  </div>
  <div class={styles["items-container"]}>
    
    <ItemTransportation
      icon="microbus"
      title="Lineas"
      description={[
        "Lineas que dejan a unos metros",
        "108, 138, T, 136, R, 148",
        "otras lineas: 42, 121",
      ]}
    />
    <ItemTransportation icon="taxi" title="Radio Movil" description={["Existen algunas que tienen su central en nuestra zona", "Remix, Oruro"]} />
  </div>
  <PrevNext prev="#invitation-event" next="#end" />

</Section>

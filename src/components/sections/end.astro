---
import Section from "../layout/section/section.astro";
import PrevNext from "../PrevNext.astro";
---

<Section className={["section section-center", "relative"].join(" ")} id="end">
    <div>
        <div class={"box"} data-aos="zoom-in-up">
            <h3>Te esperamos!!!</h3>
        </div>
    </div>

    <PrevNext prev="#transportation" next="#" />
</Section>

<style>
    .section {
        background-color: #ffcdb2;
    }

    .box {
        background-color: #f9fbff;
        border-radius: 50%;
        padding: 28px 12px;
        text-align: center;

    }

    .description {
        font-size: 1.2rem;
        text-align: center;
        line-height: 1.3;
    }
</style>

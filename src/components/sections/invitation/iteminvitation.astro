---
import styles from "./invitation.module.scss";

interface Props {

  title?: string;
  date?: string;
  hour?: string;
  direction?: string;
  other?: string;
  icon?: string;
  btnTitle?: string;
  btnUrl?: string;
  position?: "bottom";
}

const { title,
date,
hour,
direction,
other,
icon,
btnTitle,
btnUrl,
position } = Astro.props;

---
<div data-aos="zoom-in" class={[styles.item__wrap, position==="bottom" ? styles["item__wrap--bottom"] : ''].join(' ')} >
  <div class={styles.item}>
    <div style={{marginBottom: '6px'}}>
      <img src={"./images/"+icon} />
    </div>
    <h2 class={styles.item__title}>{title}</h2>
    <div class={styles.item__content}>
      <p class={styles.item__description}>
        <span class={styles.item__icon}>
          <i class="fa-solid fa-calendar-days"></i>
        </span>
        <span>{date}</span>
      </p>
      <p class={styles.item__description}>
        <span class={styles.item__icon}>
          <i class="fa-solid fa-clock"></i>
        </span>
        <span>{hour}</span>
      </p>
      <p class={styles.item__description}>
        <span class={styles.item__icon}>
          <i class="fa-solid fa-location-dot"></i>
        </span>
        <span>{direction}</span>
        <br>
        <br>
        <span>{other}</span>
        <br>
      </p>
    </div>
    <a href={btnUrl} target="_blank" class={styles.item__btn} title={btnTitle}>
      {btnTitle}
    </a>
  </div>
</div>
  

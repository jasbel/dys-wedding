---
import ItemInvitation from "./iteminvitation.astro";
import styles from "./invitation.module.scss";

import Section from "../../layout/section/section.astro";
import PrevNext from "../../PrevNext.astro";
import weddingData from "../../../data/wedding-data.ts";

const { events } = weddingData;

const [ceremonia, recepcion] = events;

---
<Section className={[styles.section, 'relative'].join(' ')} id="invitation">
  <div class={[styles.invitation__wrap].join(' ')}>
    <ItemInvitation
      title={ceremonia.title}
      date={ceremonia.date}
      hour={ceremonia.hour}
      direction={ceremonia.direction}
      other={ceremonia.transport}
      icon={ceremonia.icon}
      btnTitle={ceremonia.buttonText}
      btnUrl={ceremonia.mapUrl}
      qr={ceremonia.qr}
    />
  </div>
  <PrevNext prev="#agree" next="#invitation-event" />
</Section>

<Section className={[styles.section, 'relative'].join(' ')} id="invitation-event">
  <div class={[styles.invitation__wrap].join(' ')}>

    <!-- <figure class={styles.photoContent}>
      <img src="./images/photo-rectangle.png" />
    </figure> -->
    <ItemInvitation
      title={recepcion.title}
      date={recepcion.date}
      hour={recepcion.hour}
      direction={recepcion.direction}
      icon={recepcion.icon}
      btnTitle={recepcion.buttonText}
      position={recepcion.position as "bottom"}
      btnUrl={recepcion.mapUrl}
      qr={recepcion.qr}
      other={recepcion.transport}
    />
  </div>
  <PrevNext prev="#invitation" next="#quote" />
</Section>
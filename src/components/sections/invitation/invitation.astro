---
import ItemInvitation from "./iteminvitation.astro";
import styles from "./invitation.module.scss";

import Section from "../../layout/section/section.astro";
import PrevNext from "../../PrevNext.astro";

---
<Section className={[styles.section, 'relative'].join(' ')} id="invitation">
  <div id="invitation" class={[styles.invitation__wrap].join(' ')}>
    <ItemInvitation
      title="Ceremonia"
      date="Sabado, Enero 27 2024"
      hour="03:00 PM"
      direction="Villa Pagador"
      icon="rings.png"
      btnTitle="Abrir Mapa"
      btnUrl="https://maps.app.goo.gl/UPYfG2c4rgE3wSPR7"
    />
    <figure class={styles.photoContent}>
      <img src="./images/photo-rectangle.png" />
    </figure>
    <ItemInvitation
      title="Recepcion"
      date="Sabado, Enero 27 2024"
      hour="06:00 PM"
      direction="Villa Pagador"
      icon="coups.png"
      btnTitle="Ver Direccion"
      position="bottom"
      btnUrl="https://maps.app.goo.gl/YDCur2fUJ2B9qLn9A "
    />
  </div>
  <PrevNext prev="#hero" next="#transportation" />
</Section>
---
import ItemInvitation from "./iteminvitation.astro";
import styles from "./invitation.module.scss";

import Section from "../../layout/section/section.astro";
import PrevNext from "../../PrevNext.astro";

---
<Section className={[styles.section, 'relative'].join(' ')} id="invitation">
  <div class={[styles.invitation__wrap].join(' ')}>
    <ItemInvitation
      title="Ceremonia Religiosa"
      date="Fecha: Sabado, Enero 27, 2024"
      hour="Hora: 03:00 PM"
      direction="Iglesia Biblica Bet-El, 2 cuadras al norte del Col. Ayni Pacha, Villa Pagador"
      icon="rings.png"
      btnTitle="Abrir Mapa"
      btnUrl="https://maps.app.goo.gl/UPYfG2c4rgE3wSPR7"
    />
  </div>
  <PrevNext prev="#agree" next="#invitation-event" />
</Section>

<Section className={[styles.section, 'relative'].join(' ')} id="invitation-event">
  <div class={[styles.invitation__wrap].join(' ')}>

    <!-- <figure class={styles.photoContent}>
      <img src="./images/photo-rectangle.png" />
    </figure> -->
    <ItemInvitation
      title="Recepcion Social"
      date="Fecha: Sabado, Enero 27, 2024"
      hour="Hora: 06:00 PM"
      direction="Salon de Eventos Jaziel, entre c/ Huachacalla y Llallagua, a 2 cuadras de la plaza de Villa Pagador."
      icon="coups.png"
      btnTitle="Ver Direccion"
      position="bottom"
      btnUrl="https://maps.app.goo.gl/YDCur2fUJ2B9qLn9A "
    />
  </div>
  <PrevNext prev="#invitation" next="#transportation" />
</Section>
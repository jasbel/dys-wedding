---
import styles from "./timer.module.scss";

import Section from "../../layout/section/section.astro";
import Counter from "./counter.astro";
import PrevNext from "../../PrevNext.astro";

const url = 'https://www.google.com/calendar/event?action=TEMPLATE&text=Boda%20Christian%20y%20Melandia&dates=20260703T170000Z/20260703T200000Z&details=Descripci%C3%B3n&location=https://maps.app.goo.gl/CxAHaE9Hr17aiPit9';

---
<Section id="timer" className={[styles.section, 'relative full-width'].join(' ')}>
  <div class={styles.box}>
  <div class={styles['box-content']}>
    <h3 class={styles.title}>Cuanto falta para la boda</h3>
    
    <Counter/>
    {/* <button class={styles.button} onClick$={openCalendar}>Agregar a Calendario</button> */}
    <a class={styles.button} target="_blank" href={url} >Agregar a Calendario</a>
  </div>
  </div>
  <PrevNext prev="#quote" next="#" />

</Section>

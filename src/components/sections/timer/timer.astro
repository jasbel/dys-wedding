---
import styles from "./timer.module.scss";

import Section from "../../layout/section/section.astro";
import Counter from "./counter.astro";
import PrevNext from "../../PrevNext.astro";
import weddingData from "../../../data/wedding-data.ts";

const { timer, wedding } = weddingData;

---
<Section id="timer" className={styles.section}>
  <div class={styles.box}>
  <div class={styles['box-content']}>
    <h3 class={styles.title}>{timer.title}</h3>

    <Counter weddingDate={wedding.date}/>
    <a class={styles.button} target="_blank" href={wedding.calendarUrl}>{timer.buttonText}</a>
  </div>
  </div>
  <PrevNext prev="#quote" next="#end" />

</Section>

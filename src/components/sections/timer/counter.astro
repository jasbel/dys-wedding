---
import styles from "./timer.module.scss";

interface Props {
  weddingDate: string;
}

const { weddingDate } = Astro.props;
---

<div class={styles.counter__wrap}>
  <div class={styles.counter}>
    <h3 id="days" class={styles.counter__value}>0</h3>
    <p class={styles.counter__label}>Dias</p>
  </div>
  <div class={styles.counter}>
    <h3 id="hours" class={styles.counter__value}>0</h3>
    <p class={styles.counter__label}>Horas</p>
  </div>
  <div class={styles.counter}>
    <h3 id="minutes" class={styles.counter__value}>0</h3>
    <p class={styles.counter__label}>Minutos</p>
  </div>
  <div class={styles.counter}>
    <h3 id="seconds" class={styles.counter__value}>0</h3>
    <p class={styles.counter__label}>Segundos</p>
  </div>
</div>

<script define:vars={{ weddingDate }}>
  console.log(weddingDate)
  function updateCounter() {
    const targetDate = new Date(weddingDate);
    const currentDate = new Date();
    const difference = targetDate - currentDate;

    const days = Math.max(0, Math.floor(difference / (1000 * 60 * 60 * 24)));
    const hours = Math.max(0, Math.floor((difference % (1000 * 60 * 60 * 24)) / (1000 * 60 * 60)));
    const minutes = Math.max(0, Math.floor((difference % (1000 * 60 * 60)) / (1000 * 60)));
    const seconds = Math.max(0, Math.floor((difference % (1000 * 60)) / 1000));

    const daysEl = document.getElementById("days");
    const hoursEl = document.getElementById("hours");
    const minutesEl = document.getElementById("minutes");
    const secondsEl = document.getElementById("seconds");

    if (daysEl) daysEl.textContent = days.toString();
    if (hoursEl) hoursEl.textContent = hours.toString().padStart(2, '0');
    if (minutesEl) minutesEl.textContent = minutes.toString().padStart(2, '0');
    if (secondsEl) secondsEl.textContent = seconds.toString().padStart(2, '0');
  }

  // Actualizar inmediatamente y luego cada segundo
  updateCounter();
  setInterval(updateCounter, 1000);
</script>

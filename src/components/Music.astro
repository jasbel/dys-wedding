---
interface Props {
  title?: string;
}
---

<button id="playButton">
  <img id="playImg" src="./icons/play.svg" alt="Play" />
</button>

<!-- NOTE: Update the music file to "Marcos Vidal – Canción de Boda" -->
<!-- YouTube reference: https://www.youtube.com/watch?v=9YDOOaxvhww -->
<audio id="audioPlayer" src="./audio/music.mpeg"></audio>

<!-- <audio controls autoplay style="width: 120px">
  <source src="./audio/music.mpeg" type="audio/mpeg">
  Tu navegador no soporta el elemento de audio.
</audio> -->

<script>
  let audioPlayer = document.getElementById(
    "audioPlayer",
  ) as HTMLAudioElement | null;
  let playButton = document.getElementById("playButton")!;
  let playImg = document.getElementById("playImg") as HTMLImageElement;

 
  document.addEventListener("DOMContentLoaded", () => {
     async function playAudio() {
    try {
      // debugger;
      audioPlayer = document.getElementById(
        "audioPlayer",
      ) as HTMLAudioElement | null;
      await audioPlayer?.play();
      playImg.src = "./icons/pause.svg";
    } catch (error) {
      console.warn("Error reproduciendo audio:", error);
    }
  }
  
    audioPlayer = document.getElementById(
      "audioPlayer",
    ) as HTMLAudioElement | null;
    playButton = document.getElementById("playButton")!;
    playImg = document.getElementById("playImg") as HTMLImageElement;

    if (!audioPlayer) {
      console.error("Elemento de audio no encontrado");
      return;
    }

    function activeMusic() {
      playAudio();
    }

    function pauseMusic() {
      audioPlayer?.pause();
      playImg.src = "./icons/play.svg";
    }

    playButton.addEventListener("click", () => {
      if (audioPlayer?.paused) {
        activeMusic();
      } else {
        pauseMusic();
      }
    });

    setTimeout(() => {
      activeMusic();
    }, 2000);
    // activeMusic();
  });
</script>
<style>
  #playButton {
    color: rgb(53, 39, 132);
    background-color: #eef2f356;
    width: 35px;
    height: 35px;
    display: flex;
    justify-content: center;
    align-items: center;
    position: fixed;
    z-index: 10;
    padding: 10px;
    bottom: 15px;
    right: 15px;
    border-radius: 50px;
    /* visibility:  ; */
  }
</style>
